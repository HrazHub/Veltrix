{
  "name": "veltrix",
  "version": "1.0.0",
  "description": "VELTRIX by HRAZHUB — Your games. One place. A premium PC game library manager.",
  "author": {
    "name": "HRAZHUB",
    "email": "support@hrazhub.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "icon": "node scripts/build-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build && electron-builder --win --dir --x64",
    "verify": "node scripts/verify.mjs",
    "postinstall": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.24.2",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.hrazhub.veltrix",
    "productName": "VELTRIX",
    "copyright": "Copyright © 2026 HRAZHUB. All rights reserved.",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs",
      "name": "veltrix",
      "productName": "VELTRIX"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "VELTRIX",
      "signtoolOptions": {
        "publisherName": "HRAZHUB"
      },
      "legalTrademarks": "VELTRIX by HRAZHUB",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VELTRIX",
      "uninstallDisplayName": "VELTRIX",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "VELTRIX-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "VELTRIX-Portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
